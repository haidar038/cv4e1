exports[`CreativeRenderer markup baselines (regresi visual — committed snapshots) > fresh graduate document (photo enabled in source) > fresh graduate markup 1`] = `"<link rel="preload" as="image" href="blob:photo-asset_sample_photo_01"/><article class="cv-creative _doc_7125e4"><aside class="_sidebar_7125e4"><img class="_photo_7125e4" src="blob:photo-asset_sample_photo_01" alt="Rania Putri Maharani"/><p class="_contactLine_7125e4">rania.contoh@example.com</p><p class="_contactLine_7125e4">+62 812-0000-0000</p><p class="_contactLine_7125e4">Ternate, Maluku Utara</p><p class="_linkLine_7125e4"><a href="https://www.linkedin.com/in/contoh">LinkedIn: https://www.linkedin.com/in/contoh</a></p><section class="_section_7125e4"><h2 class="_heading_7125e4">KEAHLIAN</h2><article class="_item_7125e4"><p class="_itemTitle_7125e4"><strong>Teknis: </strong>JavaScript, React, HTML, CSS, Git, MySQL</p></article><article class="_item_7125e4"><p class="_itemTitle_7125e4"><strong>Bahasa: </strong>Bahasa Indonesia, Bahasa Inggris (pasif)</p></article></section></aside><div class="_main_7125e4"><h1 class="_name_7125e4">Rania Putri Maharani</h1><p class="_headline_7125e4">Fresh Graduate Teknik Informatika</p><p class="_summary_7125e4">Lulusan Teknik Informatika dengan pengalaman organisasi kemahasiswaan dan proyek akhir di bidang pengembangan web. Terbiasa bekerja dalam tim kecil dan mengelola jadwal kegiatan.</p><section class="_section_7125e4"><h2 class="_heading_7125e4">PENDIDIKAN</h2><article class="_item_7125e4"><p class="_itemTitle_7125e4"><strong>Universitas Contoh Nusantara</strong></p><p class="_itemMeta_7125e4">S1 Teknik Informatika · Rekayasa Perangkat Lunak · Ternate</p><p class="_itemMeta_7125e4">Agustus 2021 – Juli 2025 · Lulus · IPK: 3.52 / 4.00</p><ul><li>Tugas akhir: sistem informasi pendataan UMKM berbasis web</li></ul></article></section><section class="_section_7125e4"><h2 class="_heading_7125e4">PENGALAMAN KERJA</h2><article class="_item_7125e4"><p class="_itemTitle_7125e4"><strong>CV Contoh Digital</strong> — Magang Pengembang Web</p><p class="_itemMeta_7125e4">Magang · Ternate</p><p class="_itemMeta_7125e4">Juli 2024 – Desember 2024</p><ul><li>Membangun tiga halaman antarmuka untuk aplikasi pendataan internal</li><li>Menyusun dokumentasi penggunaan aplikasi untuk staf non-teknis</li></ul></article></section><section class="_section_7125e4"><h2 class="_heading_7125e4">ORGANISASI</h2><article class="_item_7125e4"><p class="_itemTitle_7125e4"><strong>Himpunan Mahasiswa Teknik Informatika</strong> — Koordinator Divisi Acara</p><p class="_itemMeta_7125e4">Organisasi</p><p class="_itemMeta_7125e4">Januari 2023 – Desember 2023</p><ul><li>Mengkoordinasikan panitia beranggotakan 15 orang untuk seminar teknologi tingkat fakultas</li><li>Menyusun rundown dan jadwal koordinasi mingguan selama masa persiapan</li></ul></article></section><section class="_section_7125e4"><h2 class="_heading_7125e4">PROYEK</h2><article class="_item_7125e4"><p class="_itemTitle_7125e4"><strong>Sistem Pendataan UMKM</strong> — Pengembang</p><p class="_itemMeta_7125e4">Tugas akhir</p><p class="_itemMeta_7125e4">September 2024 – Juni 2025</p><ul><li>Merancang basis data dan antarmuka pendataan untuk 5 kategori usaha</li><li>Menguji aplikasi bersama 8 pelaku usaha untuk mengumpulkan masukan</li></ul></article></section><section class="_section_7125e4"><h2 class="_heading_7125e4">SERTIFIKASI</h2><article class="_item_7125e4"><p class="_itemTitle_7125e4"><strong>Belajar Dasar Pemrograman Web</strong></p><p class="_itemMeta_7125e4">Platform Pelatihan Contoh · Maret 2024</p></article></section></div></article>"`;

