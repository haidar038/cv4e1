exports[`ATSRenderer markup baselines (regresi visual — committed snapshots) > fresh graduate document (photo enabled in source) > fresh graduate markup 1`] = `"<article class="cv-ats"><header class="cv-ats-header"><h1 class="cv-ats-name">Rania Putri Maharani</h1><p class="cv-ats-headline">Fresh Graduate Teknik Informatika</p><p class="cv-ats-contacts">rania.contoh@example.com · +62 812-0000-0000 · Ternate, Maluku Utara</p><p class="cv-ats-links"><span><a href="https://www.linkedin.com/in/contoh">LinkedIn: https://www.linkedin.com/in/contoh</a></span></p><p class="cv-ats-summary">Lulusan Teknik Informatika dengan pengalaman organisasi kemahasiswaan dan proyek akhir di bidang pengembangan web. Terbiasa bekerja dalam tim kecil dan mengelola jadwal kegiatan.</p></header><section class="cv-ats-section"><h2 class="cv-ats-heading">PENDIDIKAN</h2><article class="cv-ats-item"><p class="cv-ats-item-title"><strong>Universitas Contoh Nusantara</strong></p><p class="cv-ats-item-meta">S1 Teknik Informatika · Rekayasa Perangkat Lunak · Ternate</p><p class="cv-ats-item-meta">Agustus 2021 – Juli 2025 · Lulus · IPK: 3.52 / 4.00</p><ul><li>Tugas akhir: sistem informasi pendataan UMKM berbasis web</li></ul></article></section><section class="cv-ats-section"><h2 class="cv-ats-heading">PENGALAMAN KERJA</h2><article class="cv-ats-item"><p class="cv-ats-item-title"><strong>CV Contoh Digital</strong> — Magang Pengembang Web</p><p class="cv-ats-item-meta">Magang · Ternate</p><p class="cv-ats-item-meta">Juli 2024 – Desember 2024</p><ul><li>Membangun tiga halaman antarmuka untuk aplikasi pendataan internal</li><li>Menyusun dokumentasi penggunaan aplikasi untuk staf non-teknis</li></ul></article></section><section class="cv-ats-section"><h2 class="cv-ats-heading">ORGANISASI</h2><article class="cv-ats-item"><p class="cv-ats-item-title"><strong>Himpunan Mahasiswa Teknik Informatika</strong> — Koordinator Divisi Acara</p><p class="cv-ats-item-meta">Organisasi</p><p class="cv-ats-item-meta">Januari 2023 – Desember 2023</p><ul><li>Mengkoordinasikan panitia beranggotakan 15 orang untuk seminar teknologi tingkat fakultas</li><li>Menyusun rundown dan jadwal koordinasi mingguan selama masa persiapan</li></ul></article></section><section class="cv-ats-section"><h2 class="cv-ats-heading">PROYEK</h2><article class="cv-ats-item"><p class="cv-ats-item-title"><strong>Sistem Pendataan UMKM</strong> — Pengembang</p><p class="cv-ats-item-meta">Tugas akhir</p><p class="cv-ats-item-meta">September 2024 – Juni 2025</p><ul><li>Merancang basis data dan antarmuka pendataan untuk 5 kategori usaha</li><li>Menguji aplikasi bersama 8 pelaku usaha untuk mengumpulkan masukan</li></ul></article></section><section class="cv-ats-section"><h2 class="cv-ats-heading">KEAHLIAN</h2><article class="cv-ats-item"><p class="cv-ats-item-title"><strong>Teknis: </strong>JavaScript, React, HTML, CSS, Git, MySQL</p></article><article class="cv-ats-item"><p class="cv-ats-item-title"><strong>Bahasa: </strong>Bahasa Indonesia, Bahasa Inggris (pasif)</p></article></section><section class="cv-ats-section"><h2 class="cv-ats-heading">SERTIFIKASI</h2><article class="cv-ats-item"><p class="cv-ats-item-title"><strong>Belajar Dasar Pemrograman Web</strong></p><p class="cv-ats-item-meta">Platform Pelatihan Contoh · Maret 2024</p></article></section></article>"`;

